<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg5"
    android:scaleType="centerCrop"
    android:padding="0dp">

    <!-- 主界面 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg5"
        android:scaleType="centerCrop"
        android:padding="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="?attr/colorPrimary"
            app:title="学生选课系统"
            app:titleTextColor="#FFFFFF"
            app:titleCentered="true"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/jd2"
                android:layout_gravity="center_horizontal"
                android:scaleType="fitCenter"/>

        </androidx.appcompat.widget.Toolbar>

        <!-- 顶部欢迎区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="22dp"
                android:gravity="center_vertical">

                <!-- 用户头像 -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"

                    android:scaleType="centerCrop"
                    android:background="@drawable/user1"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="欢迎回来"
                        android:textSize="15sp"
                        android:textColor="#6C757D"/>

                    <TextView
                        android:id="@+id/tv_welcome_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="尊敬的用户"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#212529"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 学生功能区 -->
                <LinearLayout
                    android:id="@+id/student_functions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="36dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="学生功能"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#212529"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        android:background="#FFFFFF">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:useDefaultMargins="true"
                            android:padding="24dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_profile"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="个人信息"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_edit_profile"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="修改信息"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user1"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_my_courses"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="我的课程"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_course_table"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="我的课表"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user1"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_apply_course"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="申请课程"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_my_grades"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="我的成绩"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user1"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                        </GridLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- 管理员功能区 -->
                <LinearLayout
                    android:id="@+id/admin_functions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="36dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="管理员功能"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#212529"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="6dp"
                        android:background="#FFFFFF">

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:useDefaultMargins="true"
                            android:padding="24dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_manage_students"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="学生管理"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_manage_courses"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="课程管理"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user1"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_reports"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="数据报表"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_add_course"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="添加课程"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/user1"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>


                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_grade_management"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="成绩管理"
                                android:textSize="15sp"
                                android:textColor="#212529"
                                app:icon="@drawable/jluu"
                                app:iconSize="24dp"
                                app:iconTint="?attr/colorPrimary"
                                app:strokeColor="#E9ECEF"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_logout"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_columnWeight="1"
                                android:text="退出登录"
                                android:textSize="15sp"
                                android:textColor="#E53935"
                                app:icon="@drawable/jlu"
                                app:iconSize="24dp"
                                app:iconTint="#E53935"
                                app:strokeColor="#FFCDD2"
                                app:strokeWidth="1dp"
                                app:cornerRadius="20dp"/>

                        </GridLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 侧边栏 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>