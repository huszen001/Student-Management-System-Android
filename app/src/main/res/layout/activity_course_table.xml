<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <!-- 工具栏 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2196F3"
        app:title="我的课表"
        app:titleCentered="true"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 课表卡片容器 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- ===================== 表头行 ===================== -->
                <TextView
                    android:id="@+id/header_section"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="节次"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/header_mon"/>

                <TextView
                    android:id="@+id/header_mon"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="周一"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/header_section"
                    app:layout_constraintEnd_toStartOf="@id/header_tue"/>

                <TextView
                    android:id="@+id/header_tue"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="周二"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/header_mon"
                    app:layout_constraintEnd_toStartOf="@id/header_wed"/>

                <TextView
                    android:id="@+id/header_wed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="周三"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/header_tue"
                    app:layout_constraintEnd_toStartOf="@id/header_thu"/>

                <TextView
                    android:id="@+id/header_thu"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="周四"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/header_wed"
                    app:layout_constraintEnd_toStartOf="@id/header_fri"/>

                <TextView
                    android:id="@+id/header_fri"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="周五"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:background="#E3F2FD"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/header_thu"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- ===================== 1-2节行 ===================== -->
                <TextView
                    android:id="@+id/row1_section"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:text="1-2节"
                    android:textSize="14sp"
                    android:textColor="#607D8B"
                    app:layout_constraintTop_toBottomOf="@id/header_section"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/mon1"/>

                <TextView
                    android:id="@+id/mon1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_bg"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#0D47A1"
                    app:layout_constraintTop_toBottomOf="@id/header_mon"
                    app:layout_constraintStart_toEndOf="@id/row1_section"
                    app:layout_constraintEnd_toStartOf="@id/tue1"/>

                <TextView
                    android:id="@+id/tue1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_bg"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#0D47A1"
                    app:layout_constraintTop_toBottomOf="@id/header_tue"
                    app:layout_constraintStart_toEndOf="@id/mon1"
                    app:layout_constraintEnd_toStartOf="@id/wed1"/>

                <TextView
                    android:id="@+id/wed1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_bg"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#0D47A1"
                    app:layout_constraintTop_toBottomOf="@id/header_wed"
                    app:layout_constraintStart_toEndOf="@id/tue1"
                    app:layout_constraintEnd_toStartOf="@id/thu1"/>

                <TextView
                    android:id="@+id/thu1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_bg"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#0D47A1"
                    app:layout_constraintTop_toBottomOf="@id/header_thu"
                    app:layout_constraintStart_toEndOf="@id/wed1"
                    app:layout_constraintEnd_toStartOf="@id/fri1"/>

                <TextView
                    android:id="@+id/fri1"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_bg"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#0D47A1"
                    app:layout_constraintTop_toBottomOf="@id/header_fri"
                    app:layout_constraintStart_toEndOf="@id/thu1"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- ===================== 3-4节行 ===================== -->
                <TextView
                    android:id="@+id/row2_section"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:text="3-4节"
                    android:textSize="14sp"
                    android:textColor="#607D8B"
                    app:layout_constraintTop_toBottomOf="@id/row1_section"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/mon2"/>

                <TextView
                    android:id="@+id/mon2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_green"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#00796B"
                    app:layout_constraintTop_toBottomOf="@id/mon1"
                    app:layout_constraintStart_toEndOf="@id/row2_section"
                    app:layout_constraintEnd_toStartOf="@id/tue2"/>

                <TextView
                    android:id="@+id/tue2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_green"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#00796B"
                    app:layout_constraintTop_toBottomOf="@id/tue1"
                    app:layout_constraintStart_toEndOf="@id/mon2"
                    app:layout_constraintEnd_toStartOf="@id/wed2"/>

                <TextView
                    android:id="@+id/wed2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_green"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#00796B"
                    app:layout_constraintTop_toBottomOf="@id/wed1"
                    app:layout_constraintStart_toEndOf="@id/tue2"
                    app:layout_constraintEnd_toStartOf="@id/thu2"/>

                <TextView
                    android:id="@+id/thu2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_green"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#00796B"
                    app:layout_constraintTop_toBottomOf="@id/thu1"
                    app:layout_constraintStart_toEndOf="@id/wed2"
                    app:layout_constraintEnd_toStartOf="@id/fri2"/>

                <TextView
                    android:id="@+id/fri2"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_green"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#00796B"
                    app:layout_constraintTop_toBottomOf="@id/fri1"
                    app:layout_constraintStart_toEndOf="@id/thu2"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- ===================== 晚自习行 ===================== -->
                <TextView
                    android:id="@+id/row3_section"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:text="晚自习"
                    android:textSize="14sp"
                    android:textColor="#607D8B"
                    app:layout_constraintTop_toBottomOf="@id/row2_section"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/mon3"/>

                <TextView
                    android:id="@+id/mon3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_yellow"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#F57F17"
                    app:layout_constraintTop_toBottomOf="@id/mon2"
                    app:layout_constraintStart_toEndOf="@id/row3_section"
                    app:layout_constraintEnd_toStartOf="@id/tue3"/>

                <TextView
                    android:id="@+id/tue3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_yellow"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#F57F17"
                    app:layout_constraintTop_toBottomOf="@id/tue2"
                    app:layout_constraintStart_toEndOf="@id/mon3"
                    app:layout_constraintEnd_toStartOf="@id/wed3"/>

                <TextView
                    android:id="@+id/wed3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_yellow"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#F57F17"
                    app:layout_constraintTop_toBottomOf="@id/wed2"
                    app:layout_constraintStart_toEndOf="@id/tue3"
                    app:layout_constraintEnd_toStartOf="@id/thu3"/>

                <TextView
                    android:id="@+id/thu3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_yellow"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#F57F17"
                    app:layout_constraintTop_toBottomOf="@id/thu2"
                    app:layout_constraintStart_toEndOf="@id/wed3"
                    app:layout_constraintEnd_toStartOf="@id/fri3"/>

                <TextView
                    android:id="@+id/fri3"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:background="@drawable/course_cell_yellow"
                    android:layout_margin="3dp"
                    android:padding="8dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="#F57F17"
                    app:layout_constraintTop_toBottomOf="@id/fri2"
                    app:layout_constraintStart_toEndOf="@id/thu3"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>